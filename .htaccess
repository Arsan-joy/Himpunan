Options -Indexes

# ============================================================
# SECURITY: Deny dotfiles (.env, .gitignore, dll.)
# ============================================================
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# ============================================================
# SECURITY: Deny debug files
# ============================================================
<FilesMatch "^debug.*\.php$">
    Require all denied
</FilesMatch>
<IfModule !mod_authz_core.c>
    <FilesMatch "^debug.*\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# ============================================================
# PERFORMANCE: Gzip / Brotli Compression
# Mengurangi network payload hingga 70%
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2

    # Jangan compress file yang sudah terkompresi
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|zip|gz|bz2|rar)$ no-gzip dont-vary
</IfModule>

# ============================================================
# PERFORMANCE: Browser Caching (Avoid enormous network payloads)
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Gambar — 1 tahun (immutable)
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"

    # CSS & JS — 1 tahun (dengan cache-busting ?v= di header.php)
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"

    # Font — 1 tahun
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/font-woff     "access plus 1 year"
    ExpiresByType application/font-woff2    "access plus 1 year"

    # HTML/PHP — 1 jam
    ExpiresByType text/html                 "access plus 1 hour"
    ExpiresByType application/xhtml+xml     "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    # Aset statis: immutable 1 tahun
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header unset Pragma
    </FilesMatch>

    # HTML/PHP: 1 jam, revalidate
    <FilesMatch "\.php$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # Admin: no-store
    <If "%{REQUEST_URI} =~ m#/admin/#">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header unset ETag
    </If>

    # ETag untuk conditional requests
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)$">
        FileETag MTime Size
    </FilesMatch>

    # Vary: Accept-Encoding agar CDN cache versi compressed
    <FilesMatch "\.(css|js|html|php)$">
        Header append Vary Accept-Encoding
    </FilesMatch>
</IfModule>

# ============================================================
# PERFORMANCE: Keep-Alive
# ============================================================
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>

# ============================================================
# PERFORMANCE: Remove ETags untuk file statis (opsional)
# Beberapa server menggunakan inode di ETag yang tidak konsisten di multi-server
# ============================================================
# FileETag None
